{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/send-email",
      "destination": "/api/index.js"
    },
    {
      "source": "/products/BHScope",
      "destination": "https://omni-tensors-dashboard-as5u.vercel.app/products/BHScope"
    },
    {
      "source": "/products/BHScope/:path*",
      "destination": "https://omnitensors-dashboard.vercel.app/products/BHScope/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/$1"
    }
  ]
}
