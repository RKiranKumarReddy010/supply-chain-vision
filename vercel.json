{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/send-email",
      "destination": "/api/index.js"
    },
    {
      "source": "/products",
      "destination": "/index.html"
    },
    {
      "source": "/products/BHScope/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/products/LeadForge/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/$1"
    }
  ]
}
